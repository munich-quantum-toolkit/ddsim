{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "Default configuration. Uses the Ninja generator",
      "generator": "Ninja"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "lint",
      "inherits": "base",
      "displayName": "Lint config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_MQT_DDSIM_BINDINGS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": {
        "repeat": { "mode": "until-pass", "count": 3 },
        "timeout": 600
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage"
    }
  ]
}
